# Force LF for all shell scripts to prevent CRLF issues on Linux/macOS/Android/iOS
*.sh        text eol=lf
*.sh        diff=sh

# Windows scripts keep CRLF
*.bat       text eol=crlf
*.ps1       text eol=crlf
*.cmd       text eol=crlf

# Default for everything else - git decides
*           text=auto
